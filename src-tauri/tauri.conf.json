{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Priority Planner",
  "version": "0.1.2",
  "identifier": "it.priorityplanner.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Priority Planner",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "android": { "minSdkVersion": 24 }
  }
}
